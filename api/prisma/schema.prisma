// TutorFlow database schema.
// Conventions:
// - Every tenant-owned table has `centerId`; every query must filter by the logged-in user's center.
// - Instants (a specific lesson) are stored as UTC `timestamptz`.
// - Recurring wall-clock times ("16:00" every Monday) are stored as "HH:mm" strings in Africa/Cairo time,
//   because the UTC offset changes with daylight saving time.
// - Money is Decimal(10,2) in EGP, never a float.

generator client {
  provider = "prisma-client-js"
}

// Copy of the client for the web app, which imports ONLY `enums.ts` from it
// (Role, AttendanceStatus…) so both sides share one source of truth.
// Regenerated by every `prisma generate` / `prisma migrate dev`; committed so Vercel needs no extra step.
generator web {
  provider = "prisma-client"
  output   = "../../web/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Enums ─────────────

enum Role {
  ADMIN
  ASSISTANT
  TUTOR
}

enum SchoolType {
  AMERICAN
  IGCSE
  NATIONAL
  IB
}

enum LessonStatus {
  SCHEDULED
  CANCELED
}

enum AttendanceStatus {
  PENDING
  COMPLETED
  NO_SHOW
  CANCELED
}

enum ChangeRequestType {
  RESCHEDULE
  CANCEL
}

enum ChangeRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ───────────── Tenancy & users ─────────────

model Center {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  users           User[]
  tutorProfiles   TutorProfile[]
  availability    AvailabilitySlot[]
  students        Student[]
  subjects        Subject[]
  grades          Grade[]
  priceRules      PriceRule[]
  lessonSeries    LessonSeries[]
  lessons         Lesson[]
  attendance      LessonAttendance[]
  changeRequests  ChangeRequest[]
  monthlyReports  MonthlyReport[]
  auditLogs       AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  centerId     String
  role         Role
  name         String
  email        String   @unique // globally unique: login is email + password only
  phone        String?
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  center               Center            @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tutorProfile         TutorProfile?
  markedAttendance     LessonAttendance[]
  requestedChanges     ChangeRequest[]   @relation("RequestedBy")
  reviewedChanges      ChangeRequest[]   @relation("ReviewedBy")
  auditLogs            AuditLog[]

  @@index([centerId, role])
}

model TutorProfile {
  userId   String  @id
  centerId String
  meetLink String?

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  center       Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subjects     Subject[]          // many-to-many: subjects this tutor teaches
  grades       Grade[]            // many-to-many: grades this tutor teaches
  availability AvailabilitySlot[]
  lessonSeries LessonSeries[]
  lessons      Lesson[]
  reports      MonthlyReport[]

  @@index([centerId])
}

model AvailabilitySlot {
  id        String @id @default(uuid())
  centerId  String
  tutorId   String
  weekday   Int    // 0 = Sunday … 6 = Saturday
  startTime String // "HH:mm", Africa/Cairo
  endTime   String // "HH:mm", Africa/Cairo

  center Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tutor  TutorProfile @relation(fields: [tutorId], references: [userId], onDelete: Cascade)

  @@index([centerId, weekday])
  @@index([tutorId])
}

// ───────────── Students & catalog ─────────────

model Student {
  id         String     @id @default(uuid())
  centerId   String
  name       String
  phone      String?
  email      String?
  parentName String?
  gradeId    String
  schoolType SchoolType
  timezone   String     @default("Africa/Cairo") // IANA zone, e.g. "Asia/Dubai"
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  center       Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  grade        Grade              @relation(fields: [gradeId], references: [id])
  lessonSeries LessonSeries[]
  attendance   LessonAttendance[]

  @@index([centerId])
}

model Subject {
  id       String @id @default(uuid())
  centerId String
  name     String

  center       Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tutors       TutorProfile[]
  priceRules   PriceRule[]
  lessonSeries LessonSeries[]
  lessons      Lesson[]

  @@unique([centerId, name])
}

model Grade {
  id       String @id @default(uuid())
  centerId String
  name     String

  center     Center         @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tutors     TutorProfile[]
  students   Student[]
  priceRules PriceRule[]

  @@unique([centerId, name])
}

model PriceRule {
  id           String     @id @default(uuid())
  centerId     String
  subjectId    String
  gradeId      String
  schoolType   SchoolType
  durationMin  Int        // 60 | 90 | 120 (validated in the API)
  studentPrice Decimal    @db.Decimal(10, 2) // what the center charges, EGP
  tutorPay     Decimal    @db.Decimal(10, 2) // what the tutor receives, EGP

  center  Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)

  @@unique([centerId, subjectId, gradeId, schoolType, durationMin])
}

// ───────────── Scheduling ─────────────

model LessonSeries {
  id          String    @id @default(uuid())
  centerId    String
  tutorId     String
  subjectId   String
  weekdays    Int[]     // e.g. [1, 3] = Monday & Wednesday
  startTime   String    // "HH:mm", Africa/Cairo
  durationMin Int
  startDate   DateTime  @db.Date
  endDate     DateTime? @db.Date
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)

  center   Center       @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tutor    TutorProfile @relation(fields: [tutorId], references: [userId])
  subject  Subject      @relation(fields: [subjectId], references: [id])
  students Student[]    // 1 student = 1:1 lesson, 2+ = group lesson
  lessons  Lesson[]

  @@index([centerId])
  @@index([tutorId])
}

model Lesson {
  id          String       @id @default(uuid())
  centerId    String
  seriesId    String?      // null for one-off lessons
  tutorId     String
  subjectId   String
  startsAt    DateTime     @db.Timestamptz(3) // UTC instant
  durationMin Int
  status      LessonStatus @default(SCHEDULED)
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(3)

  center         Center             @relation(fields: [centerId], references: [id], onDelete: Cascade)
  series         LessonSeries?      @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  tutor          TutorProfile       @relation(fields: [tutorId], references: [userId])
  subject        Subject            @relation(fields: [subjectId], references: [id])
  attendance     LessonAttendance[]
  changeRequests ChangeRequest[]

  @@index([centerId, startsAt])
  @@index([tutorId, startsAt])
  @@index([seriesId])
}

// One row per (lesson, student). Group lessons have several rows.
model LessonAttendance {
  id               String           @id @default(uuid())
  centerId         String
  lessonId         String
  studentId        String
  status           AttendanceStatus @default(PENDING)
  // Copied from the matching PriceRule when marked COMPLETED, so later price changes don't rewrite history.
  priceSnapshot    Decimal?         @db.Decimal(10, 2)
  tutorPaySnapshot Decimal?         @db.Decimal(10, 2)
  priceMissing     Boolean          @default(false) // no PriceRule matched when marked
  markedById       String?
  markedAt         DateTime?        @db.Timestamptz(3)

  center   Center  @relation(fields: [centerId], references: [id], onDelete: Cascade)
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student  Student @relation(fields: [studentId], references: [id])
  markedBy User?   @relation(fields: [markedById], references: [id], onDelete: SetNull)

  @@unique([lessonId, studentId])
  @@index([centerId, status])
  @@index([studentId])
}

model ChangeRequest {
  id               String              @id @default(uuid())
  centerId         String
  lessonId         String
  type             ChangeRequestType
  proposedStartsAt DateTime?           @db.Timestamptz(3) // required for RESCHEDULE
  reason           String
  status           ChangeRequestStatus @default(PENDING)
  requestedById    String
  reviewedById     String?
  reviewedAt       DateTime?           @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  center      Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  requestedBy User   @relation("RequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?  @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([centerId, status])
}

// ───────────── Reporting & audit ─────────────

model MonthlyReport {
  id         String    @id @default(uuid())
  centerId   String
  tutorId    String?   // null = the whole-center report
  month      String    // "YYYY-MM" in Africa/Cairo
  data       Json      // frozen snapshot of the payment table + analytics
  lockedAt   DateTime? @db.Timestamptz(3)
  reopenedAt DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)

  center Center        @relation(fields: [centerId], references: [id], onDelete: Cascade)
  tutor  TutorProfile? @relation(fields: [tutorId], references: [userId], onDelete: SetNull)

  @@unique([centerId, tutorId, month])
  @@index([centerId, month])
}

model AuditLog {
  id        String   @id @default(uuid())
  centerId  String
  actorId   String?
  action    String   // e.g. "attendance.update"
  entity    String   // e.g. "LessonAttendance"
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  center Center @relation(fields: [centerId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([centerId, createdAt])
}
